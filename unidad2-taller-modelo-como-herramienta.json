ebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ============================================================\n# EJEMPLO A REEMPLAZAR — bórralo y pega aquí tu propio código\n# ============================================================\n# Dataset de ejemplo: predicción de cancelación de clientes (churn)\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import accuracy_score, classification_report\n\nnp.random.seed(42)\nn = 500\ndatos_ejemplo = pd.DataFrame({\n    \"antiguedad_meses\": np.random.randint(1, 72, n),\n    \"quejas_registradas\": np.random.poisson(1.2, n),\n    \"gasto_mensual\": np.round(np.random.normal(50, 15, n), 2),\n})\n# Variable objetivo simulada con una relación simple + ruido\nprobabilidad_cancela = (\n    0.4\n    - 0.004 * datos_ejemplo[\"antiguedad_meses\"]\n    + 0.15 * datos_ejemplo[\"quejas_registradas\"]\n    + np.random.normal(0, 0.1, n)\n)\ndatos_ejemplo[\"cancela\"] = (probabilidad_cancela > 0.3).astype(int)\n\nX = datos_ejemplo[[\"antiguedad_meses\", \"quejas_registradas\", \"gasto_mensual\"]]\ny = datos_ejemplo[\"cancela\"]\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\n\nmodelo = RandomForestClassifier(n_estimators=100, random_state=42)\nmodelo.fit(X_train, y_train)\n\ny_pred = modelo.predict(X_test)\nprint(f\"Exactitud en datos de prueba: {accuracy_score(y_test, y_pred):.2%}\")\nprint(classification_report(y_test, y_pred))\n","key":"TPRq7Xyo5u"},{"type":"outputs","id":"zSQ48ffzABz5vXc_YTkLk","children":[],"key":"tVBKfG7r93"}],"identifier":"8b1757fc","html_id":"8b1757fc","key":"VASgTPZwRj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Paso 2 — Guarda los pesos de tu modelo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OkAYN2hn9V"}],"identifier":"paso-2-guarda-los-pesos-de-tu-modelo","label":"Paso 2 — Guarda los pesos de tu modelo","html_id":"paso-2-guarda-los-pesos-de-tu-modelo","implicit":true,"key":"vVogR1yQol"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Guardamos el modelo entrenado en disco con ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QNX4BfctZl"},{"type":"inlineCode","value":"joblib","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GcID0QEs0M"},{"type":"text","value":", para que la función-herramienta del Paso 3 pueda cargarlo sin tener que reentrenarlo cada vez que el agente la invoque (en producción real nunca querrías reentrenar un modelo cada vez que alguien lo consulta).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X33CNPIidT"}],"key":"INs9TlJ4KE"}],"identifier":"95a2e938","html_id":"95a2e938","key":"zhsDlvZ6yN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"NOMBRE_ARCHIVO_MODELO = \"mi_modelo.pkl\"\njoblib.dump(modelo, NOMBRE_ARCHIVO_MODELO)\nprint(f\"Modelo guardado en: {NOMBRE_ARCHIVO_MODELO}\")\n","key":"Qa1obdD9q6"},{"type":"outputs","id":"ie1DlEVurIyBwDrLOBuGj","children":[],"key":"aA1Hp7hOBn"}],"identifier":"3d90a515","html_id":"3d90a515","key":"I0Zx0nkvwd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Paso 3 — Convierte tu modelo en una herramienta (tool)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hG52en2sTl"}],"identifier":"paso-3-convierte-tu-modelo-en-una-herramienta-tool","label":"Paso 3 — Convierte tu modelo en una herramienta (tool)","html_id":"paso-3-convierte-tu-modelo-en-una-herramienta-tool","implicit":true,"key"